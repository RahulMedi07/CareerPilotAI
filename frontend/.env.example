# Copy to .env.local and adjust. .env.local is gitignored; this file is not.
#
# This is the only variable the frontend reads. `NEXT_PUBLIC_` is a public
# prefix: anything named that way is inlined into the JavaScript bundle and is
# visible to anyone who opens the page, so no secret belongs in this file.
#
# The backend must also list this origin in CORS_ORIGINS (backend/config.py),
# or the browser blocks every request regardless of what is set here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Deliberately absent:
#
#   NEXT_PUBLIC_APP_NAME - the name is set once, in app/layout.tsx metadata.
#                          An env var that nothing reads is a setting that lies.
#   NEXT_PUBLIC_VERSION  - read live from GET /api/health/full and shown on the
#                          settings page, so it cannot drift from the backend
#                          that is actually answering.

# CareerPilot AI - example configuration.
#
#   cp .env.example .env
#
# Every line below is optional: the defaults in config.py are the same values.
# .env is gitignored - never commit real keys.

# --- API -------------------------------------------------------------------
APP_NAME=CareerPilot AI
APP_VERSION=0.1.0
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# Enables uvicorn auto-reload. Set to false in production.
DEBUG=true
# Must be a JSON array - pydantic-settings parses list fields as JSON.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Paths -----------------------------------------------------------------
# Relative paths are resolved against the backend/ folder, not your shell's
# working directory, so these mean the same thing wherever you launch from.
UPLOAD_DIR=./data/uploads
CHROMA_DB_PATH=./data/chroma
LOG_DIR=./data/logs

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt",".md"]

# --- RAG / embeddings ------------------------------------------------------
# Changing this invalidates the existing index: embeddings from two different
# models are not comparable. Clear data/chroma and re-upload after a change.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=250
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# --- Database (Chroma vector store) ----------------------------------------
# The folder itself is CHROMA_DB_PATH, up under "Paths".
CHROMA_COLLECTION_NAME=resumes
CHROMA_DISTANCE=cosine

# --- LLM -------------------------------------------------------------------
# ollama | claude | auto
LLM_PROVIDER=ollama
LLM_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
# Short on purpose: a dead Ollama should fail fast, not stall every request.
LLM_HEALTHCHECK_TIMEOUT=2.0
LLM_MAX_RETRIES=2

# --- Claude fallback -------------------------------------------------------
LLM_FALLBACK_ENABLED=true
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Leave blank to run Ollama-only. Never commit a real key.
ANTHROPIC_API_KEY=

# --- Gemini ----------------------------------------------------------------
# Set LLM_PROVIDER=gemini above to use this. Needs no extra package: the
# handler calls the REST API with `requests`, which is already installed.
# Get a key from https://aistudio.google.com/apikey
# The free tier is small and counted per model per day - gemini-2.5-flash
# allows twenty requests a day, and one full analysis spends about six.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
# Set false to log to the console only (useful in containers).
LOG_TO_FILE=true
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# --- Accounts --------------------------------------------------------------
# Sign-in details live in their own SQLite file, separate from the job data,
# so you can delete one without losing the other. It holds email addresses
# and salted PBKDF2 password hashes -- never a password, and never a session
# token, only the hash of one. Do not put this file in a zip you share.
AUTH_DB_PATH=data/users.db
# How long a sign-in lasts before it has to be repeated, in hours. The
# default is two weeks: long enough not to nag, short enough that a forgotten
# session on a borrowed laptop eventually stops working. Signing out revokes
# immediately regardless.
SESSION_TTL_HOURS=336

# --- Job discovery ---------------------------------------------------------
# Set false to switch the discovery endpoints off entirely; they then return
# 503 and no outbound request is ever made. Useful if you would rather this
# machine never talked to the internet.
JOB_DISCOVERY_ENABLED=true
# Saved jobs live in SQLite. Delete the file to start over.
JOBS_DB_PATH=data/jobs.db
# Sent on every request so the sites we read can identify and contact us.
# An honest User-Agent is the minimum courtesy of automated fetching.
JOB_SCRAPER_USER_AGENT=CareerPilotAI/0.1 (+https://github.com/example/career-pilot-ai)
JOB_FETCH_TIMEOUT_SECONDS=10.0
# Hard ceiling on a downloaded response. A feed that streams forever cannot
# fill this machine's memory.
JOB_FETCH_MAX_BYTES=2097152
# Attempts per fetch, including the first. Only timeouts, connection failures,
# 429 and 5xx are retried - a 404 will say the same thing on the third try.
JOB_FETCH_MAX_ATTEMPTS=3
# Base of the exponential wait between attempts, in seconds (plus jitter, so
# that clients which failed together do not all return together).
JOB_FETCH_BACKOFF_FACTOR=2.0
# Minimum gap between two requests to the same host - politeness, enforced.
JOB_FETCH_MIN_INTERVAL_SECONDS=1.0
# Six hours. Remotive's own terms ask for at most about four fetches a day,
# and this cache is how that is honoured rather than merely promised.
JOB_CACHE_TTL_SECONDS=21600
# Obey robots.txt. Turn this off only for a host you own.
JOB_RESPECT_ROBOTS=true

# Adzuna, from https://developer.adzuna.com - free tier, takes a minute.
# Optional: leave both blank and the source quietly does not run. Filling
# them in adds Indian listings that Adzuna licenses from the boards and
# employers themselves, each with a direct link to its own advert. This is
# the supported way to reach that market; LinkedIn, Indeed, Naukri, Foundit
# and Wellfound all forbid reading their listings directly.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
